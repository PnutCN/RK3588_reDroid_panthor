# =============================================================================
# Android Mesa + PanVK + GBM 构建脚手架 —— 冻结版本 / 可调参数
# =============================================================================
# 对应移植清单 6.2「为 Android/Bionic 重编 Mesa」。所有脚本 `source` 本文件。
# 改动这里即可整体切换基线，无需改脚本逻辑。
#
# 目标：Orange Pi 5 Max (RK3588 / Mali-G610 MP4) 上的 reDroid 容器
#       —— 内核 Panthor KMD，容器内 Android arm64 Mesa(Panfrost gallium + PanVK)。
# =============================================================================

# ---- 目标 ABI ---------------------------------------------------------------
# 仅 arm64（reDroid RK3588）。如需 32 位 arm 兼容另起一套 cross-file。
TARGET_ARCH=arm64                 # device_redroid-prebuilts 的 prebuilts/<arch> 目录名
MESON_CPU_FAMILY=aarch64          # meson [host_machine] cpu_family
MESON_CPU=armv8                   # meson [host_machine] cpu
NDK_TRIPLE=aarch64-linux-android  # NDK clang --target 前缀
NDK_ABI=aarch64-linux-android     # NDK sysroot/usr/lib/<abi> 目录名

# ---- Android API / platform-sdk-version -------------------------------------
# LineageOS 20 = Android 13 = API 33。Mesa 的 -Dplatform-sdk-version 与之对齐，
# 决定 AHardwareBuffer / mapper4 / nativewindow 等条件编译分支。
# 必须 >= 29（mesa.build 对 >=29 启用 ELF-TLS 修正）。
ANDROID_API=33
PLATFORM_SDK_VERSION=33

# ---- NDK --------------------------------------------------------------------
# 优先使用环境已有的 NDK（GH runner: $ANDROID_NDK_LATEST_HOME / $ANDROID_NDK_HOME）。
# 否则按下面版本下载到 $WORK/ndk。r27c 为 LTS，含统一 clang(--target) 工具链。
NDK_VERSION=r27c
NDK_URL_BASE=https://dl.google.com/android/repository
NDK_ZIP=android-ndk-${NDK_VERSION}-linux.zip

# ---- Mesa -------------------------------------------------------------------
# 上游 mesa（与本分析树 mesa-current 同一 commit）。含：
#   src/panfrost/lib/kmod/panthor_kmod.c  (DRM_IOCTL_PANTHOR_*)
#   src/panfrost/vulkan/panvk_android.c   (PanVK AHardwareBuffer 集成)
MESA_GIT=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_COMMIT=25b4dfabf1238079b9d505db4446b42f297dbe33   # 26.3.0-devel
# 若本地已有 mesa-current 稀疏克隆，00-fetch-sources.sh 会就地展开为全量。
MESA_LOCAL_DIR=${REPO_ROOT:-}/mesa-current

# ---- libdrm -----------------------------------------------------------------
# Mesa 26.3 要求 libdrm >= 2.4.109（meson.build:_drm_ver）。GBM 依赖 libdrm。
# 注意：panthor UAPI 头由 Mesa 自带(include/drm-uapi/panthor_drm.h)，
#       libdrm 本身无 panthor 子模块，这里只需要 libdrm 核心库。
LIBDRM_VERSION=2.4.123
LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-${LIBDRM_VERSION}.tar.xz

# ---- AOSP 头/stub 垫片（standalone NDK 路线需要）---------------------------
# NDK sysroot 缺 AOSP 专有头：cutils/ hardware/ log/ sync/ nativewindow/ system/。
# gen-android-sysroot.sh 从下面 pin 的 LineageOS 镜像(lineage-20.0=android-13)
# 稀疏拉取这些头，并为 libcutils/libhardware 生成链接期 stub .so。
AOSP_MIRROR=https://github.com/LineageOS
AOSP_TAG=lineage-20.0
# repo -> 需要拷入 shim include 的子目录（相对 repo 根）
AOSP_HEADER_REPOS="\
  android_hardware_libhardware:include \
  android_system_core:libcutils/include:libsync/include \
  android_system_logging:liblog/include \
  android_frameworks_native:libs/nativewindow/include:libs/nativebase/include:vulkan/libvulkan/include \
"

# ---- 输出 -------------------------------------------------------------------
# 打包目标：device_redroid-prebuilts/prebuilts/arm64/ 布局（见 30-package-prebuilts.sh）
PREBUILT_LAYOUT_ARM64=prebuilts/${TARGET_ARCH}
